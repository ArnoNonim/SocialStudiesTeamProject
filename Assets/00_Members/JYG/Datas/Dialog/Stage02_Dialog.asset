  m_Script: {fileID: 11500000, guid: aa3ee6d11a29af249b1c7d3917cfe910, type: 3}
  m_Name: Stage02_Dialog
  m_EditorClassIdentifier: Assembly-CSharp::_00_Members.JYG._Scripts.UISystem.DialogSystem.DialogData
  contents:
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uCCAB \uC784\uBB34\uB97C \uC798 \uC644\uC218\uD574\uC8FC\uC5C8\uB124."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uB2E4\uC74C \uC784\uBB34\uB3C4 \uBE44\uC2B7\uD574. \uB611\uAC19\uC774
      \uC801\uAD70\uC744 \uCC3E\uC544 \uC0AC\uC0B4\uD558\uBA74 \uB418\uB294 \uC784\uBB34\uB77C\uB124.
      \uC815\uCC30\uC5D0 \uC758\uD558\uBA74, \uD0C0\uAC9F\uC774 \uB2E4\uB9AC \uD55C\uCABD\uC744
      \uB2E4\uCCE4\uB2E4\uACE0 \uD558\uB354\uAD70."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC544, \uACE7 \uB4DC\uB860 \uC7A5\uBE44\uB4E4\uB3C4 \uAC15\uD654\uAC00
      \uB420 \uC608\uC815\uC774\uB2C8 \uCC38\uACE0\uD574\uB450\uAC8C."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC784\uBB34 \uC131\uACF5\uB960\uC5D0 \uB530\uB77C \uC21C\uCC28\uC801\uC73C\uB85C
      \uC9C0\uAE09\uB420\uAC70\uC57C."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE48\uB2E4\uB124."
