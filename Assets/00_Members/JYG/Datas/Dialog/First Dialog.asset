--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa3ee6d11a29af249b1c7d3917cfe910, type: 3}
  m_Name: First Dialog
  m_EditorClassIdentifier: Assembly-CSharp::_00_Members.JYG._Scripts.UISystem.DialogSystem.DialogData
  contents:
  - speakerName: "\uBB34\uC804\uAE30"
    content: '...

'
  - speakerName: "\uBB34\uC804\uAE30"
    content: ...
  - speakerName: "\uBB34\uC804\uAE30"
    content: "(\uAC70\uC13C \uC7A1\uC74C\uC774 \uB4E4\uB824\uC628\uB2E4.)"
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC544, \uC544, \uD1B5\uC2E0 \uC0C1\uD0DC \uD655\uC778."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC2E0\uBCD1, \uC798 \uB4E4\uB9AC\uB098?"
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC790\uB124\uB294 \uB85C\uC2A4\uD1A0\uBE44\uC544\uC640\uC758 \uC804\uC7C1\uC5D0\uC11C,
      \uB4DC\uB860\uC744 \uC774\uC6A9\uD574  \uD6C4\uBC29 \uC9C0\uC6D0\uC744 \uB9E1\uAC8C
      \uB418\uC5C8\uB124. "
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uD604\uC7AC \uC804\uC7A5\uC5D0\uB294 \uB2E4\uC218\uC758 \uC801\uAD70\uC774
      \uD655\uC778\uB418\uACE0 \uC788\uC5B4,  \uC790\uB124\uC5D0\uAC8C \uB4DC\uB860
      \uC6B4\uC6A9 \uAD8C\uD55C\uC744 \uBD80\uC5EC\uD55C\uB2E4. \uC9C0\uAE08\uBD80\uD130
      \uC804\uB2EC\uB418\uB294 \uC88C\uD45C\uC640 \uC2DD\uBCC4 \uC815\uBCF4\uC5D0
      \uB530\uB77C \uC784\uBB34\uB97C \uC218\uD589\uD558\uB3C4\uB85D."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uB4DC\uB860\uC740 \uC5F4 \uAC10\uC9C0 \uAE30\uB2A5\uC744 \uD1B5\uD574
      \uC790\uB124\uC5D0\uAC8C \uC2DC\uAC01\uC801\uC778 \uC815\uBCF4\uB97C \uC804\uB2EC\uD574\uC904\uAC70\uB2E4.
      \uBCC4\uB3C4\uC758 \uC9C0\uC2DC\uAC00 \uC5C6\uB294 \uD55C, \uC9C0\uC815\uB41C
      \uBAA9\uD45C\uB9CC \uC0AC\uC0B4\uD558\uB3C4\uB85D."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC774\uBC88 \uC791\uC804\uC758 \uBAA9\uC801\uC740 \uC801 \uC804\uB825\uC758
      \uC57D\uD654\uB2E4. \uC6B0\uC120 \uC9C0\uC2DC\uAC00 \uB2E4\uC2DC \uB0B4\uB824\uC62C\uB54C\uAE4C\uC9C0
      \uB300\uAE30\uD558\uB77C."
  - speakerName: 
    content: "\uB2F9\uC2E0\uC740 \uC9C0\uC2DC\uAC00 \uB0B4\uB824\uC62C\uB54C\uAE4C\uC9C0
      \uB300\uAE30\uD55C\uB2E4."
  - speakerName: "\uBB34\uC804\uAE30"
    content: ...
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uB0A8\uCABD\uC5D0\uC11C \uBD80\uC0C1 \uB2F9\uD55C \uC801\uAD70\uC774
      \uD558\uB098 \uBC1C\uACAC \uB418\uC5C8\uB124."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC55E\uC5D0 \uB4DC\uB860\uC744 \uC870\uC885\uD560 \uC218 \uC788\uB294
      \uCEE8\uD2B8\uB864\uB7EC\uB85C WASD\uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD574 \uC6C0\uC9C1\uC774\uACE0,
      \uBC29\uD5A5\uD0A4\uB85C \uD654\uBA74\uC744 \uC870\uC815\uD574 \uC801\uC744
      \uC0AC\uC0B4\uD558\uAC8C."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uC88C\uCE21 \uC0C1\uB2E8\uC758 \uD654\uBA74\uC5D0\uB294 \uC784\uBB34\uAC00
      \uD45C\uC2DC\uB420\uAC70\uB77C\uB124. \uCCAB \uC784\uBB34\uB85C \uC790\uB124\uC758
      \uC2E4\uB825\uC744 \uC99D\uBA85\uD574\uBCF4\uAC8C."
