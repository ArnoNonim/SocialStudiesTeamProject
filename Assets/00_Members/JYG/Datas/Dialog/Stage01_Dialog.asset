      \uB2E4\uCCE4\uB2E4\uACE0 \uD558\uB354\uAD70."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uBAA9\uD45C\uC758 \uC774\uB3D9\uC774 \uB290\uB824 \uC790\uB124\uC758
      \uB2E4\uC74C \uBAA9\uD45C\uB85C \uC801\uC808\uD588\uB2E4\uB124."
  - speakerName: "\uBB34\uC804\uAE30"
    content: "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE48\uB2E4\uB124."
